@model NickCM_AtlasTaskFlow.Models.Project

@{
    ViewData["Title"] = Model.Name;
    var totalTasks = Model.Tasks.Count;
    var completedTasks = Model.Tasks.Count(t =>
        t.Status == NickCM_AtlasTaskFlow.Models.TaskStatus.Completed);
    var progress = totalTasks == 0
        ? 0
        : (int)Math.Round(completedTasks * 100.0 / totalTasks);
}

<div class="container py-4 project-details-page">
    <div class="project-back mb-4">
        <a asp-action="Index" class="project-back-link">
            &larr; Back to My Projects
        </a>
    </div>


    

    <div class="project-heading d-flex justify-content-between align-items-start mb-4">
        <div>
            <div class="project-eyebrow">PROJECT WORKSPACE</div>
            <h1 class="project-title">@Model.Name</h1>
            <p class="project-description">
                @(Model.Description ?? "No description provided.")
            </p>
            <div class="project-dates d-flex flex-wrap gap-4 mt-3 mb-2">
                <div>
                    <span class="text-muted small d-block">Start Date</span>
                    <strong>
                        @(Model.StartDate?.ToString("MMM d, yyyy") ?? "Not set")
                    </strong>
                </div>

                <div>
                    <span class="text-muted small d-block">End Date</span>
                    <strong>
                        @(Model.EndDate?.ToString("MMM d, yyyy") ?? "Not set")
                    </strong>
                </div>
            </div>
        </div>
        <span class="project-type-badge">Project</span>
    </div>
    <div  class="project-actions d-flex flex-wrap gap-2 mb-4">
        <a asp-controller="Tasks"
           asp-action="Index"
           asp-route-id="@Model.Id"
           class="btn btn-atlas project-btn-primary">
            View Tasks
        </a>

        <a asp-controller="Tasks"
           asp-action="Create"
           asp-route-projectId="@Model.Id"
           class="btn btn-atlas project-btn-primary">
            Create Task
        </a>
        <a asp-controller="Projects"
           asp-action="ManageMembers"
           asp-route-id="@Model.Id"
           class="btn btn-atlas project-btn-primary">
            Manage Members
        </a>
        <a asp-controller="Tasks"
           asp-action="Board"
           asp-route-id="@Model.Id"
           class="btn btn-atlas project-btn-primary">
            Open Kanban Board
        </a>
        <a asp-controller="Projects"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-atlas project-btn-primary">
            <icon name="pencil" size="sm" /> Edit Project
        </a>
        <a asp-controller="Projects"
           asp-action="Activity"
           asp-route-id="@Model.Id"
           class="btn btn-atlas project-btn-primary">
            <icon name="history" size="sm" /> Project Activity
        </a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 project-stat-card">
                <div class="card-body">
                    <p class="project-stat-label mb-1">Total tasks</p>
                    <h2 class="project-stat-number">@totalTasks</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 project-stat-card">
                <div class="card-body">
                    <p class="project-stat-label mb-1">Completed</p>
                    <h2 class="project-stat-number">@completedTasks</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 project-stat-card">
                <div class="card-body">
                    <p class="text-muted mb-1">Project progress</p>
                    <h2>@progress%</h2>
                    <div class="progress project-progress-bar"
                         role="progressbar"
                         aria-valuenow="@progress"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        <div class="progress-bar"
                             style="width: @progress%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 project-panel">
        <div class="card-header project-panel-header">
            <h5 class="mb-0">Team Members</h5>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var member in Model.Members)
            {
                <li class="list-group-item">
                    @(member.User.DisplayName
                        ?? member.User.Email
                        ?? "Team member")
                    <span class="text-muted ms-2">
                        @member.Role
                    </span>
                </li>
            }
        </ul>
    </div>

    <div class="card project-panel">
        <div class="card-header d-flex justify-content-between align-items-center project-panel-header">
            <h5 class="mb-0">Tasks</h5>
            <span class="text-muted">@totalTasks total</span>
        </div>

        @if (!Model.Tasks.Any())
        {
            <div class="card-body">
                <p class="text-muted mb-0">
                    No tasks have been created for this project yet.
                </p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var task in Model.Tasks.OrderBy(t => t.DueDate))
                {
                    <div class="list-group-item project-task-row">
                        <strong>@task.Title</strong>
                        <span class="badge bg-secondary ms-2">
                            @task.Status
                        </span>
                        @if (task.DueDate.HasValue)
                        {
                            <div class="small text-muted">
                                Due @task.DueDate.Value.ToString("MMM d, yyyy")
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
