@model NickCM_AtlasTaskFlow.Models.TaskItem
@using TaskStatus = NickCM_AtlasTaskFlow.Models.TaskStatus
@using NickCM_AtlasTaskFlow.Models
@using NickCM_AtlasTaskFlow.ViewModels

@{
    ViewData["Title"] = "Task Details";

    var isOverdue =
        Model.DueDate.HasValue &&
        Model.DueDate.Value.Date < DateTime.Today &&
        Model.Status != TaskStatus.Completed;
}

<div class="d-flex justify-content-between align-items-start
            flex-wrap gap-3 mb-4">
    <div>
        <a asp-controller="Tasks"
           asp-action="Board"
           asp-route-id="@Model.ProjectId"
           class="text-decoration-none">
            &larr; Back to Kanban Board
        </a>

        <h1 class="mt-3">@Model.Title</h1>

        <p class="text-muted mb-0">
            Project:
            <a asp-controller="Projects"
               asp-action="Details"
               asp-route-id="@Model.ProjectId">
                @Model.Project.Name
            </a>
        </p>
    </div>

<div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="badge fs-6 @(
        Model.Status switch
        {
            TaskStatus.ToDo => "bg-secondary",
            TaskStatus.InProgress => "bg-primary",
            TaskStatus.Review => "bg-warning text-dark",
            TaskStatus.Completed => "bg-success",
            _ => "bg-secondary"
        })">
        @Model.Status
    </span>

    <a asp-controller="Tasks"
       asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-primary">
        <i class="bi bi-pencil"></i> Edit Task
    </a>
</div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Description</h5>

                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-0">
                        No description has been provided.
                    </p>
                }
                else
                {
                    <p class="mb-0"
                       style="white-space: pre-wrap">@Model.Description</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Task information</h5>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Task ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">
                        @Model.CreatedAtUtc.ToString("MMM d, yyyy HH:mm") UTC
                    </dd>

                    <dt class="col-sm-4">Due date</dt>
                    <dd class="col-sm-8">
                        @if (Model.DueDate.HasValue)
                        {
                            <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                @Model.DueDate.Value.ToString("MMM d, yyyy")
                                @if (isOverdue)
                                {
                                    <span>(Overdue)</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No due date</span>
                        }
                    </dd>
                </dl>
            </div>

        </div>
        <div>

        </div>
         <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Priority</h5>

                <span class="badge fs-6 @(
                    Model.Priority switch
                    {
                        TaskPriority.Critical => "bg-danger",
                        TaskPriority.High => "bg-warning text-dark",
                        TaskPriority.Medium => "bg-primary",
                        _ => "bg-secondary"
                    })">
                    @Model.Priority
                </span>
            </div>
        </div>


    </div>
    <div class="card mt-4">
    <div class="card-body">
        <h4 class="card-title mb-4">
            <i class="bi bi-chat-dots"></i>
            Task Discussion
            <span class="badge bg-secondary">
                @Model.Comments.Count
            </span>
        </h4>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-controller="Tasks"
              asp-action="AddComment"
              method="post"
              class="mb-4">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="TaskItemId"
                   value="@Model.Id" />

            <div class="mb-3">
                <label for="commentContent" class="form-label">
                    Write a comment
                </label>

                <textarea id="commentContent"
                          name="Content"
                          class="form-control"
                          rows="3"
                          maxlength="2000"
                          placeholder="Share an update or ask a question..."
                          required></textarea>

                <div class="form-text">
                    Maximum 2,000 characters.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-send"></i>
                Post Comment
            </button>
        </form>

        <hr />

        @if (Model.Comments.Any())
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var comment in Model.Comments)
                {
                    <div class="border rounded p-3">
                        <div class="d-flex justify-content-between
                                    align-items-start flex-wrap gap-2 mb-2">

                            <div class="fw-semibold">
                                @(comment.Author.DisplayName
                                    ?? comment.Author.UserName
                                    ?? "Unknown user")
                            </div>

                            <small class="text-muted">
                                @comment.CreatedAtUtc.ToString(
                                    "MMM d, yyyy h:mm tt") UTC
                            </small>
                        </div>

                        <p class="mb-0"
                           style="white-space: pre-wrap; overflow-wrap: anywhere">@comment.Content</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-chat-square-text fs-2"></i>
                <p class="mt-2 mb-0">
                    No comments yet. Start the discussion!
                </p>
            </div>
        }
    </div>
</div>
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Ownership</h5>

                @if (Model.Owner == null)
                {
                    <p class="text-muted mb-0">
                        This task is unclaimed.
                    </p>
                }
                else
                {
                    <p class="fw-semibold mb-1">
                        @(Model.Owner.DisplayName
                            ?? Model.Owner.UserName
                            ?? "Unknown user")
                    </p>

                    <p class="text-muted small mb-0">
                        @Model.Owner.Email
                    </p>
                }

                @if (Model.Owner == null)
                {
                    <form asp-controller="Tasks"
                          asp-action="Claim"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="mt-3">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-atlas project-btn-primary">
                            Claim This Task
                        </button>
                    </form>
                }
            </div>
        </div>

       
    </div>
</div>