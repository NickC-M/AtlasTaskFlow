<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />


<title>@ViewData["Title"] - AtlasTaskFlow</title>

<script type="importmap"></script>

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/NickCM_AtlasTaskFlow.styles.css"
      asp-append-version="true" />
</head>
<body>
@if (ViewData["FullWidthLayout"] as bool? != true)
{
        <!-- Application Navigation -->
        <nav class="navbar navbar-expand-lg atlas-navbar atlas-app-navbar">
            <div class="atlas-container w-100 d-flex align-items-center justify-content-between py-2">

                <!-- Brand -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="atlas-brand">
                    <span class="atlas-logo">A</span>
                    <span>AtlasTaskFlow</span>
                </a>

                <!-- Mobile Menu -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#atlasNavigation"
                        aria-controls="atlasNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse"
                     id="atlasNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3 mt-3 mt-lg-0">

                        <li class="nav-item">
                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="nav-link">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Projects"
                               asp-action="Index"
                               class="nav-link">
                                My Projects
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Tasks"
                               asp-action="MyTasks"
                               class="nav-link">
                                My Tasks
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="nav-link">
                                Home
                            </a>
                        </li>

                        <!-- Existing Login / Account Controls -->
                        <li class="nav-item">
                            <partial name="_LoginPartial" />
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    }

<main role="main" class="@(ViewData["FullWidthLayout"] as bool? == true ? "" : "container pb-3")">
    @RenderBody()
</main>

@if (ViewData["FullWidthLayout"] as bool? != true)
{
    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; @DateTime.Now.Year - AtlasTaskFlow -
            <a asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>