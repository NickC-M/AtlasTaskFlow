@{
    ViewData["Title"] = "AtlasTaskFlow | Project Management Made Clear";
    ViewData["FullWidthLayout"] = true;
}
<style>
:root {
--atlas-navy: #101b35;
--atlas-navy-light: #192a4d;
--atlas-blue: #3978f6;
--atlas-blue-hover: #2864db;
--atlas-bg: #f5f8fd;
--atlas-text: #344054;
--atlas-muted: #667085;
}

</style>

<div class="atlas-home">


<!-- Navigation -->
<nav class="navbar navbar-expand-lg atlas-navbar">
    <div class="atlas-container w-100 d-flex align-items-center justify-content-between py-2">
        <a asp-controller="Home" asp-action="Index" class="atlas-brand">
            <span class="atlas-logo">A</span>
            <span>AtlasTaskFlow</span>
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#atlasNavigation"
                aria-controls="atlasNavigation"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="atlasNavigation">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3 mt-3 mt-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="#features">Features</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#how-it-works">How It Works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#about">About</a>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="btn btn-atlas">
                            Open My Dashboard
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="nav-link">
                            Log In
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Identity"
                           asp-page="/Account/Register"
                           class="btn btn-atlas">
                            Get Started
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Hero -->
<section class="hero">
    <div class="atlas-container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-copy">
                    <div class="eyebrow">
                        <span class="eyebrow-dot"></span>
                        A clearer way to manage projects
                    </div>

                    <h1>
                        Great work starts with <span>clear direction.</span>
                    </h1>

                    <p class="hero-description">
                        Bring your projects, tasks, and team conversations
                        together in one organized workspace. Spend less time
                        chasing updates and more time moving work forward.
                    </p>

                    <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn btn-atlas">
                                Go to My Dashboard &rarr;
                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Register"
                               class="btn btn-atlas">
                                Get Started &rarr;
                            </a>

                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               class="btn btn-atlas-outline">
                                Sign In
                            </a>
                        }
                    </div>

                    <p class="hero-note">
                        Plan together. Track progress. Deliver with confidence.
                    </p>
                </div>
            </div>

            <!-- Illustrative Kanban preview -->
            <div class="col-lg-6">
                <div class="hero-visual">
                    <div class="preview-shell">
                        <div class="preview-topbar">
                            <div class="d-flex align-items-center gap-3">
                                <div class="preview-dots">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                                <div class="preview-project">Website Redesign</div>
                            </div>
                            <span class="preview-tag">Project Board</span>
                        </div>

                        <div class="kanban-preview">
                            <div class="kanban-column">
                                <div class="kanban-heading">
                                    <span class="status-dot" style="background:#98a2b3"></span>
                                    To Do
                                </div>

                                <div class="task-preview">
                                    <h6>Research user needs</h6>
                                    <span class="task-label">High</span>
                                    <div class="task-footer">
                                        <span class="avatar">JD</span>
                                        <span class="mini-date">Oct 24</span>
                                    </div>
                                </div>

                                <div class="task-preview">
                                    <h6>Outline new pages</h6>
                                    <span class="task-label blue">Medium</span>
                                    <div class="task-footer">
                                        <span class="avatar">MK</span>
                                        <span class="mini-date">Oct 27</span>
                                    </div>
                                </div>
                            </div>

                            <div class="kanban-column">
                                <div class="kanban-heading">
                                    <span class="status-dot" style="background:#3978f6"></span>
                                    In Progress
                                </div>

                                <div class="task-preview">
                                    <h6>Design dashboard</h6>
                                    <span class="task-label blue">High</span>
                                    <div class="task-footer">
                                        <span class="avatar">AL</span>
                                        <span class="mini-date">Oct 25</span>
                                    </div>
                                </div>

                                <div class="task-preview">
                                    <h6>Build components</h6>
                                    <span class="task-label">Medium</span>
                                    <div class="task-footer">
                                        <span class="avatar">JD</span>
                                        <span class="mini-date">Oct 29</span>
                                    </div>
                                </div>
                            </div>

                            <div class="kanban-column">
                                <div class="kanban-heading">
                                    <span class="status-dot" style="background:#12b76a"></span>
                                    Completed
                                </div>

                                <div class="task-preview">
                                    <h6>Set project goals</h6>
                                    <span class="task-label green">Done</span>
                                    <div class="task-footer">
                                        <span class="avatar">MK</span>
                                        <span class="mini-date">Oct 20</span>
                                    </div>
                                </div>

                                <div class="task-preview">
                                    <h6>Team kickoff</h6>
                                    <span class="task-label green">Done</span>
                                    <div class="task-footer">
                                        <span class="avatar">AL</span>
                                        <span class="mini-date">Oct 21</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between px-2 pt-3 pb-2">
                            <span class="text-secondary small">Illustrative project preview</span>
                            <span class="text-primary small fw-semibold">Keep work moving &rarr;</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="section" id="features">
    <div class="atlas-container">
        <div class="section-heading">
            <div class="section-kicker">Everything in one place</div>
            <h2>All the tools your team needs to move forward</h2>
            <p>
                Keep work visible, responsibilities clear, and project
                conversations connected to the tasks that matter.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">&#9638;</div>
                    <h3>Visual Kanban Boards</h3>
                    <p>
                        See tasks move from To Do to In Progress, Review,
                        and Completed. Understand your team's progress at a glance.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">&#10003;</div>
                    <h3>Clear Task Ownership</h3>
                    <p>
                        Assign tasks to team members or let members claim
                        available work so everyone knows who is responsible.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">&#9776;</div>
                    <h3>Priorities and Due Dates</h3>
                    <p>
                        Organize work by urgency, set deadlines, and make
                        important tasks easier to identify.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">&#9993;</div>
                    <h3>Task Discussions</h3>
                    <p>
                        Keep comments and updates attached to individual
                        tasks so important context stays easy to find.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">&#9998;</div>
                    <h3>Flexible Task Management</h3>
                    <p>
                        Create and edit task details as requirements change,
                        without losing sight of the bigger project.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">&#9673;</div>
                    <h3>Organized Projects</h3>
                    <p>
                        Bring project work into a shared workspace where
                        members can access the tasks relevant to their team.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section class="section section-soft" id="how-it-works">
    <div class="atlas-container">
        <div class="section-heading">
            <div class="section-kicker">A simpler workflow</div>
            <h2>From scattered tasks to shared progress</h2>
            <p>
                A straightforward way to organize your work and keep
                everyone moving in the same direction.
            </p>
        </div>

        <div class="row g-5">
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">01</div>
                    <h3>Create your project</h3>
                    <p>
                        Set up a project, bring in your team, and establish
                        a shared place for your work.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">02</div>
                    <h3>Organize your tasks</h3>
                    <p>
                        Add descriptions, priorities, due dates, and owners.
                        Break larger goals into manageable work.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">03</div>
                    <h3>Collaborate and deliver</h3>
                    <p>
                        Update task statuses, discuss details, and track
                        progress as work moves toward completion.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About-->
<section class="section" id="about">
    <div class="atlas-container">
        <div class="section-heading mb-0">
            <div class="section-kicker">Built for focused work</div>
            <h2>Less confusion. More forward momentum.</h2>
            <p>
                AtlasTaskFlow brings the everyday essentials of project
                management together, helping teams stay organized and
                keep important work visible.
            </p>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="atlas-container">
        <div class="cta-panel">
            <h2>Ready to bring your work together?</h2>
            <p>
                Create a more organized way to manage tasks, collaborate
                with your team, and move projects forward.
            </p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-atlas">
                    Open My Dashboard &rarr;
                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-atlas">
                    Get Started Today &rarr;
                </a>
            }
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="atlas-footer">
    <div class="atlas-container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="atlas-brand">
                <span class="atlas-logo">A</span>
                <span>AtlasTaskFlow</span>
            </a>

            <span class="footer-muted">
                &copy; @DateTime.Now.Year AtlasTaskFlow. All rights reserved.
            </span>

            <div class="d-flex gap-3">
                <a href="#features" class="footer-link">Features</a>
                <a href="#how-it-works" class="footer-link">How It Works</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="footer-link">
                        Dashboard
                    </a>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="footer-link">
                        Log In
                    </a>
                }
            </div>
        </div>
    </div>
</footer>
</div>